{
  "name": "judge-judy",
  "emoji": "🔍",
  "kind": "llm",
  "lane": "review",
  "schedule": {
    "interval_s": 900
  },
  "timeout_s": 900,
  "enabled": false,
  "llm": {
    "model": "sonnet",
    "max_turns": 30,
    "prompt_file": "judge-judy.md",
    "tools": {
      "allow": ["Read", "Bash(gh pr:*)", "Bash(git diff:*)", "Bash(git log:*)", "Grep", "Glob"],
      "deny": ["Bash(gh pr merge:*)", "Edit", "Write"]
    }
  },
  "report": {
    "vision_link": "optional"
  }
}
