<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit reviewer — one PR per tick, posts fleet-code-review commit status. Required
     unless you already have another review gate wired into branch protection. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/members/judge-judy/judge-judy.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>FLEET_ENV_FILE</key>
    <string>{{KIT_PATH}}/fleet.env</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/review.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/review.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
