<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit account-pool health pager — pages when every account has been failing for a
     sustained stretch, scripts/account_health_check.sh. One of the fleet's two outage pagers;
     see com.fleetkit.tunnel-health.plist for the other. Required. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.account-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/scripts/account_health_check.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>FLEET_LOG_DIR</key>
    <string>{{LOG_DIR}}</string>
    <key>NTFY_TOPIC</key>
    <string>{{NTFY_TOPIC}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/account-health.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/account-health.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
