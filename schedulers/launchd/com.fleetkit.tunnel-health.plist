<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit public-tunnel health pager — self-heals ingress drift and pages when the public
     URL is not serving, scripts/tunnel_health_check.sh. The other of the fleet's two outage
     pagers; see com.fleetkit.account-health.plist. Required. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.tunnel-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/scripts/tunnel_health_check.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>PUBLIC_URL</key>
    <string>{{PUBLIC_URL}}</string>
    <key>FLEET_VIEW_PORT</key>
    <string>{{VIEW_PORT}}</string>
    <key>NTFY_TOPIC</key>
    <string>{{NTFY_TOPIC}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/tunnel-health.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/tunnel-health.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
