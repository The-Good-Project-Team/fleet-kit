<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit account heartbeat — proves each pool account is alive on a schedule instead of
     waiting for real fleet work to reveal a stale one, scripts/account_heartbeat.sh (gh#376).
     UNLIKE com.fleetkit.account-health.plist, this script `podman exec`s into the fleet's own
     container -- it cannot run in entrypoint.sh's in-container crontab (no podman socket is
     bind-mounted there) and needs FLEET_INSTANCE_DIR/FLEET_CONTAINER_NAME, which the pure
     host-read pagers (account-health/sync-health/tunnel-health) do not. Required if you want
     the fleet's stale-account pager (the 5th of this class, per gh#154/#171/#249/#346/#378)
     turned on at all. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.account-heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/scripts/account_heartbeat.sh"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>FLEET_INSTANCE_DIR</key>
    <string>{{INSTANCE_DIR}}</string>
    <key>FLEET_CONTAINER_NAME</key>
    <string>{{CONTAINER_NAME}}</string>
    <key>FLEET_LOG_DIR</key>
    <string>{{LOG_DIR}}</string>
    <key>NTFY_TOPIC</key>
    <string>{{NTFY_TOPIC}}</string>
  </dict>
  <!-- Hourly, not the 300s other pagers use -- each tick is one real `claude -p` call per
       pool account (account_heartbeat.sh's own header), not a free log-read or curl. See
       fleetkit-account-heartbeat.timer's comment for the same reasoning; the exact interval
       is a documented UNKNOWN (gh#376) pending a human call against real per-tick cost. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/account-heartbeat.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/account-heartbeat.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
