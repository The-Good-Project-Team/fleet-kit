<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit CEO pass — self-heal + backlog drive, agents/ceo.md. Optional but recommended. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.ceo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/scripts/run_agent_pass.sh" ceo --model opus --max-turns 120</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>FLEET_ENV_FILE</key>
    <string>{{KIT_PATH}}/fleet.env</string>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/ceo.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/ceo.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
