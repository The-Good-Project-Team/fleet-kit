<?xml version="1.0" encoding="UTF-8"?>
<!-- fleet-kit architect pass — daily epic PRD + sequencing, agents/architect.md. Optional;
     without it the fleet only ever ships PR-sized increments, never features. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleetkit.architect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "{{KIT_PATH}}/scripts/run_agent_pass.sh" architect --model opus --max-turns 200</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
    <key>FLEET_ENV_FILE</key>
    <string>{{KIT_PATH}}/fleet.env</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>15</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/architect.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/Library/Logs/fleet-kit/architect.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
